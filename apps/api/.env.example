# ================================ PLEASE READ =====================================
# Environment variables supported by the Spend Book API.
# Mirrors the contract of https://github.com/we-promise/sure/blob/main/.env.example
# (plus DATABASE_URL, which the Sure test/devcontainers use).
#
# Required to boot outside tests. Copy this file to `.env` and fill in values.
# Generate SECRET_KEY_BASE with: openssl rand -hex 64
# ===================================================================================

# Enables self-hosting features (should be set to true unless you know what you're doing).
SELF_HOSTED=true

# Controls onboarding flow (valid: open, closed, invite_only).
ONBOARDING_STATE=open

# Secret key used to encrypt credentials and sign sessions.
# Must be a random string of at least 32 characters.
SECRET_KEY_BASE=change-me-run-openssl-rand-hex-64

# Port the API listens on.
PORT=3000

# Environment (development | test | production). Tests set this automatically.
NODE_ENV=development

# --------------------------------------------------------------------------------
# Postgres. Either set DATABASE_URL directly or the DB_*/POSTGRES_* pair.
# --------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sure_selfhost
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis (queues, cache, sessions).
REDIS_URL=redis://localhost:6379/1

# App branding / links generated in emails.
APP_DOMAIN=
PRODUCT_NAME=Spend Book
BRAND_NAME=Spend Book

# --------------------------------------------------------------------------------
# SMTP / email sender.
# --------------------------------------------------------------------------------
SMTP_ADDRESS=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_ENABLED=true
SMTP_TLS_SKIP_VERIFY=false
EMAIL_SENDER=

# --------------------------------------------------------------------------------
# Auth (WebAuthn / OpenID Connect).
# --------------------------------------------------------------------------------
WEBAUTHN_RP_ID=
WEBAUTHN_ALLOWED_ORIGINS=
AUTH_PASSKEY_LOGIN_ENABLED=true
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_REDIRECT_URI=

# --------------------------------------------------------------------------------
# LLM (OpenAI-compatible) + embeddings + observability.
# --------------------------------------------------------------------------------
OPENAI_ACCESS_TOKEN=
OPENAI_MODEL=
OPENAI_URI_BASE=
VECTOR_STORE_PROVIDER=openai
EMBEDDING_MODEL=
EMBEDDING_URI_BASE=
EMBEDDING_DIMENSIONS=1024
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --------------------------------------------------------------------------------
# Object storage (disk | amazon | cloudflare | generic_s3 | google).
# --------------------------------------------------------------------------------
ACTIVE_STORAGE_SERVICE=disk
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET=
GENERIC_S3_ACCESS_KEY_ID=
GENERIC_S3_SECRET_ACCESS_KEY=
GENERIC_S3_REGION=
GENERIC_S3_BUCKET=
GENERIC_S3_ENDPOINT=
GENERIC_S3_FORCE_PATH_STYLE=false
GCS_PROJECT=
GCS_BUCKET=
GCS_KEYFILE_JSON=
GCS_KEYFILE=

# --------------------------------------------------------------------------------
# Market data + analytics.
# --------------------------------------------------------------------------------
TWELVE_DATA_API_KEY=
EXCHANGE_RATE_PROVIDER=yahoo_finance
SECURITIES_PROVIDER=yahoo_finance
POSTHOG_KEY=
POSTHOG_HOST=
SKYLIGHT_AUTHENTICATION=
SKYLIGHT_ENABLED=