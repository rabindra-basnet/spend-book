// Spend Book data model, ported faithfully from we-promise/sure db/schema.rb
// (HEAD d723efb9d). Decisions per docs/migration-inventory.md §6:
//   D5  Native PG enums + CHECK-string columns -> Prisma enums (exact spellings)
//   D6  UUID PKs, except settings (bigint). OAuth tables de-scoped (D1).
// Rows that Rails keeps unconstrained (e.g. STI `type` columns, role) stay String.
// Partial / expression / GIN indexes, STORED generated columns and CHECK
// constraints cannot be expressed in Prisma schema; they are applied in the
// hand-edited initial migration (see prisma/migrations/<init>/migration.sql).

generator client {
  provider = "prisma-client"
  output   = "../src/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Native PG enums (schema.rb create_enum)
enum AccountStatus {
  ok
  syncing
  error
  @@map("account_status")
}

enum GoalPledgeKind {
  transfer
  manual_save
  @@map("goal_pledge_kind")
}

enum GoalPledgeStatus {
  open
  matched
  cancelled
  expired
  @@map("goal_pledge_status")
}

// CHECK-string columns -> Prisma enums (D5)
enum AccountSharePermission {
  full_control
  read_write
  read_only
  @@map("account_share_permission")
}

enum AccountStatementReviewStatus {
  unmatched
  linked
  rejected
  @@map("account_statement_review_status")
}

enum AccountStatementUploadStatus {
  stored
  failed
  @@map("account_statement_upload_status")
}

enum DebugLogLevel {
  debug
  info
  warn
  error
  @@map("debug_log_level")
}

enum FamilyDefaultAccountSharing {
  shared
  private
  @@map("family_default_account_sharing")
}

enum GoalKind {
  one_off
  maintained
  @@map("goal_kind")
}

enum GoalProgressBasis {
  balance
  contributions
  @@map("goal_progress_basis")
}

enum GoalState {
  active
  paused
  completed
  archived
  @@map("goal_state")
}

enum GoalTargetMode {
  fixed
  months_of_expenses
  @@map("goal_target_mode")
}

enum ImportSessionStatus {
  pending
  importing
  complete
  failed
  @@map("import_session_status")
}

enum ResourceType {
  Account
  Category
  Tag
  Merchant
  RecurringTransaction
  RecurringOccurrence
  Transaction
  Budget
  Security
  Rule
  @@map("resource_type")
}

enum InsightPriority {
  high
  medium
  low
  @@map("insight_priority")
}

enum InsightStatus {
  active
  read
  dismissed
  expired
  @@map("insight_status")
}

enum OnchainAssetKind {
  native
  erc20
  spl
  @@map("onchain_asset_kind")
}

enum AvmProvider {
  rentcast
  realie
  @@map("avm_provider")
}

enum PushEnvironment {
  sandbox
  production
  @@map("push_environment")
}

enum RecurrenceFrequency {
  weekly
  monthly
  yearly
  @@map("recurrence_frequency")
}

enum RecurringAllocationSource {
  auto_matched
  user_confirmed
  user_created
  @@map("recurring_allocation_source")
}

enum RecurringAllocationState {
  suggested
  confirmed
  @@map("recurring_allocation_state")
}

enum RecurringOccurrenceStatus {
  scheduled
  paid
  skipped
  missed
  @@map("recurring_occurrence_status")
}

enum RecurringOccurrenceClosedSource {
  auto
  user
  @@map("recurring_occurrence_closed_source")
}

enum SecurityKind {
  standard
  cash
  @@map("security_kind")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Family {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aiPromptOverrides       Json     @default("{}")
  assistantType           String   @default("builtin") @db.VarChar(255)
  autoSyncOnLogin         Boolean  @default(true)
  billsFeedToken          String?  @db.VarChar(255)
  country                 String   @default("US") @db.VarChar(255)
  createdAt               DateTime @default(now())
  currency                String   @default("USD") @db.VarChar(255)
  dataEnrichmentEnabled   Boolean  @default(false)
  dateFormat              String   @default("%m-%d-%Y") @db.VarChar(255)
  defaultAccountSharing   FamilyDefaultAccountSharing @default(shared)
  earlyAccess             Boolean  @default(false)
  enabledCurrencies       String[] @default([])
  householdBudgetEnabled  Boolean  @default(true)
  lastSyncAllAttemptedAt  DateTime?
  latestSyncActivityAt    DateTime @default(now())
  latestSyncCompletedAt   DateTime @default(now())
  locale                  String   @default("en") @db.VarChar(255)
  moniker                 String   @default("Family") @db.VarChar(255)
  monthStartDay           Int      @default(1)
  name                    String?  @db.VarChar(255)
  personalBudgets         Boolean  @default(false)
  recurringTransactionsDisabled Boolean @default(false)
  stripeCustomerId        String?  @db.VarChar(255)
  timezone                String?  @db.VarChar(255)
  updatedAt               DateTime @updatedAt
  vectorStoreId           String?  @db.VarChar(255)

  users              User[]
  invitations        Invitation[]
  subscriptions      Subscription[]
  imports            Import[]
  insights           Insight[]
  llmUsages          LlmUsage[]
  accounts           Account[]
  accountStatements  AccountStatement[]
  categories         Category[]
  merchants          Merchant[]
  familyMerchantAssociations FamilyMerchantAssociation[]
  tags               Tag[]
  rules              Rule[]
  recurringTransactions RecurringTransaction[]
  recurringOccurrences RecurringOccurrence[]
  budgets            Budget[]
  goals              Goal[]
  importSessions     ImportSession[]
  importSourceMappings ImportSourceMapping[]
  familyExports      FamilyExport[]
  familyDocuments    FamilyDocument[]

  @@unique([billsFeedToken], map: "index_families_on_bills_feed_token")
  @@map("families")
}

model User {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  active                    Boolean   @default(true)
  aiEnabled                 Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  defaultAccountId          String?   @db.Uuid
  defaultAccountOrder       String    @default("name_asc") @db.VarChar(255)
  defaultPeriod             String    @default("last_30_days") @db.VarChar(255)
  email                     String?   @db.VarChar(255)
  familyId                  String    @db.Uuid
  firstName                 String?   @db.VarChar(255)
  goals                     String[]  @default([])
  lastLoginAt               DateTime?
  lastName                  String?   @db.VarChar(255)
  lastViewedChatId          String?   @db.Uuid
  locale                    String?   @db.VarChar(255)
  onboardedAt               DateTime?
  otpBackupCodes            String[]  @default([])
  otpRequired               Boolean   @default(false)
  otpSecret                 String?   @db.VarChar(255)
  passwordDigest            String?   @db.VarChar(255)
  preferences               Json      @default("{}")
  role                      String    @default("member") @db.VarChar(255)
  rulePromptDismissedAt     DateTime?
  rulePromptsDisabled       Boolean   @default(false)
  sessionsCount             Int       @default(0)
  setOnboardingGoalsAt      DateTime?
  setOnboardingPreferencesAt DateTime?
  showAiSidebar             Boolean   @default(true)
  showSidebar               Boolean   @default(true)
  theme                     String    @default("system") @db.VarChar(255)
  uiLayout                  String?   @db.VarChar(255)
  unconfirmedEmail          String?   @db.VarChar(255)
  updatedAt                 DateTime  @updatedAt
  webauthnId                String?   @db.VarChar(255)

  family                   Family    @relation(fields: [familyId], references: [id])
  defaultAccount           Account?  @relation("UserDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)
  defaultAccountRel        Account[] @relation("AccountOwner")
  lastViewedChat           Chat?     @relation("UserLastViewedChat", fields: [lastViewedChatId], references: [id])
  sessions                 Session[]
  mobileDevices            MobileDevice[]
  webauthnCredentials      WebauthnCredential[]
  apiKeys                  ApiKey[]
  pushSubscriptions        PushSubscription[]
  oidcIdentities           OidcIdentity[]
  impersonationSessionsRun ImpersonationSession[] @relation("ImpersonationImpersonator")
  impersonationSessionsTargeted ImpersonationSession[] @relation("ImpersonationImpersonated")
  invitationsSent          Invitation[] @relation("InvitationInviter")
  budgetSharesOwned        BudgetShare[] @relation("BudgetShareOwner")
  budgetSharesViewed       BudgetShare[] @relation("BudgetShareViewer")
  budgets                  Budget[]
  accountShares            AccountShare[]
  chats                    Chat[]

  @@unique([email], map: "index_users_on_email")
  @@index([familyId], map: "index_users_on_family_id")
  @@index([lastViewedChatId], map: "index_users_on_last_viewed_chat_id")
  @@index([locale], map: "index_users_on_locale")
  @@index([preferences], map: "index_users_on_preferences", type: Gin)
  @@unique([otpSecret], map: "index_users_on_otp_secret")
  @@unique([webauthnId], map: "index_users_on_webauthn_id")
  @@map("users")
}

model Invitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  email      String?   @db.VarChar(255)
  expiresAt  DateTime?
  familyId   String    @db.Uuid
  inviterId  String    @db.Uuid
  role       String?   @db.VarChar(255)
  token      String?   @db.VarChar(255)
  tokenDigest String?  @db.VarChar(255)
  updatedAt  DateTime  @updatedAt

  family Family @relation(fields: [familyId], references: [id])
  inviter User  @relation("InvitationInviter", fields: [inviterId], references: [id])

  @@index([familyId], map: "index_invitations_on_family_id")
  @@index([inviterId], map: "index_invitations_on_inviter_id")
  @@unique([token], map: "index_invitations_on_token")
  @@unique([tokenDigest], map: "index_invitations_on_token_digest")
  @@index([email], map: "index_invitations_on_email")
  @@map("invitations")
}

model InviteCode {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now())
  token       String   @db.VarChar(255)
  tokenDigest String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt

  @@unique([token], map: "index_invite_codes_on_token")
  @@index([tokenDigest], map: "index_invite_codes_on_token_digest")
  @@map("invite_codes")
}

model Session {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activeImpersonatorSessionId String?  @db.Uuid
  createdAt                   DateTime @default(now())
  data                        Json?    @default("{}")
  ipAddress                   String?  @db.VarChar(255)
  ipAddressDigest             String?  @db.VarChar(255)
  prevTransactionPageParams   Json?    @default("{}")
  subscribedAt                DateTime?
  updatedAt                   DateTime @updatedAt
  userAgent                   String?  @db.VarChar(255)
  userId                      String   @db.Uuid

  user                 User                       @relation(fields: [userId], references: [id])
  activeImpersonator   ImpersonationSession?      @relation("SessionActiveImpersonator", fields: [activeImpersonatorSessionId], references: [id], onDelete: SetNull)

  @@index([activeImpersonatorSessionId], map: "index_sessions_on_active_impersonator_session_id")
  @@index([ipAddressDigest], map: "index_sessions_on_ip_address_digest")
  @@index([userId], map: "index_sessions_on_user_id")
  @@map("sessions")
}

model MobileDevice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appVersion  String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  deviceId    String?  @db.VarChar(255)
  deviceName  String?  @db.VarChar(255)
  deviceType  String?  @db.VarChar(255)
  lastSeenAt  DateTime?
  osVersion   String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt
  userId      String   @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId], map: "index_mobile_devices_on_user_id_and_device_id")
  @@index([userId], map: "index_mobile_devices_on_user_id")
  @@map("mobile_devices")
}

model WebauthnCredential {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime @default(now())
  credentialId String   @db.VarChar(255)
  lastUsedAt   DateTime?
  nickname     String   @db.VarChar(255)
  publicKey    String   @db.Text
  signCount    BigInt   @default(0)
  transports   String[] @default([])
  updatedAt    DateTime @updatedAt
  userId       String   @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@unique([credentialId], map: "index_webauthn_credentials_on_credential_id")
  @@index([userId], map: "index_webauthn_credentials_on_user_id")
  @@map("webauthn_credentials")
}

model ApiKey {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now())
  displayKey  String   @db.VarChar(255)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  name        String?  @db.VarChar(255)
  revokedAt   DateTime?
  scopes      Json?
  source      String   @default("web") @db.VarChar(255)
  updatedAt   DateTime @updatedAt
  userId      String   @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@unique([displayKey], map: "index_api_keys_on_display_key")
  @@index([revokedAt], map: "index_api_keys_on_revoked_at")
  @@index([userId, source], map: "index_api_keys_on_user_id_and_source")
  @@index([userId], map: "index_api_keys_on_user_id")
  @@map("api_keys")
}

model PushSubscription {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime        @default(now())
  environment       PushEnvironment
  lastRegisteredAt  DateTime
  platform          String          @default("ios") @db.VarChar(255)
  token             String          @db.VarChar(255)
  updatedAt         DateTime        @updatedAt
  userId            String          @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@index([lastRegisteredAt], map: "index_push_subscriptions_on_last_registered_at")
  @@index([userId], map: "index_push_subscriptions_on_user_id")
  @@map("push_subscriptions")
}

model OidcIdentity {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt           DateTime @default(now())
  info                Json?    @default("{}")
  issuer              String?  @db.VarChar(255)
  lastAuthenticatedAt DateTime?
  provider            String   @db.VarChar(255)
  uid                 String   @db.VarChar(255)
  updatedAt           DateTime @updatedAt
  userId              String   @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@index([issuer], map: "index_oidc_identities_on_issuer")
  @@unique([provider, uid], map: "index_oidc_identities_on_provider_and_uid")
  @@index([userId], map: "index_oidc_identities_on_user_id")
  @@map("oidc_identities")
}

model ImpersonationSession {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime @default(now())
  impersonatedId String   @db.Uuid
  impersonatorId String   @db.Uuid
  status         String   @default("pending") @db.VarChar(255)
  updatedAt      DateTime @updatedAt

  impersonated User    @relation("ImpersonationImpersonated", fields: [impersonatedId], references: [id])
  impersonator User    @relation("ImpersonationImpersonator", fields: [impersonatorId], references: [id])
  logs         ImpersonationSessionLog[]
  sessions     Session[] @relation("SessionActiveImpersonator")

  @@index([impersonatedId], map: "index_impersonation_sessions_on_impersonated_id")
  @@index([impersonatorId], map: "index_impersonation_sessions_on_impersonator_id")
  @@map("impersonation_sessions")
}

model ImpersonationSessionLog {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action                 String?  @db.VarChar(255)
  controller             String?  @db.VarChar(255)
  createdAt              DateTime @default(now())
  impersonationSessionId String   @db.Uuid
  ipAddress              String?  @db.VarChar(255)
  method                 String?  @db.VarChar(255)
  path                   String?  @db.Text
  updatedAt              DateTime @updatedAt
  userAgent              String?  @db.Text

  impersonationSession ImpersonationSession @relation(fields: [impersonationSessionId], references: [id])

  @@index([impersonationSessionId], map: "index_impersonation_session_logs_on_impersonation_session_id")
  @@map("impersonation_session_logs")
}

model Setting {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  value     String?  @db.Text
  var       String   @db.VarChar(255)

  @@unique([var], map: "index_settings_on_var")
  @@map("settings")
}

model Subscription {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount               Decimal? @db.Decimal(19, 4)
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  currency             String?  @db.VarChar(255)
  currentPeriodEndsAt  DateTime?
  familyId             String   @db.Uuid
  interval             String?  @db.VarChar(255)
  status               String   @db.VarChar(255)
  stripeId             String?  @db.VarChar(255)
  trialEndsAt          DateTime?
  updatedAt            DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id])

  @@unique([familyId], map: "index_subscriptions_on_family_id")
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Accounts & portfolio
// ---------------------------------------------------------------------------

model AccountProvider {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId    String   @db.Uuid
  createdAt    DateTime @default(now())
  providerId   String   @db.Uuid
  providerType String
  updatedAt    DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, providerType], map: "index_account_providers_on_account_and_provider_type")
  @@unique([providerType, providerId], map: "index_account_providers_on_provider_type_and_provider_id")
  @@map("account_providers")
}

model AccountShare {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String                 @db.Uuid
  createdAt         DateTime               @default(now())
  includeInFinances Boolean                @default(true)
  permission        AccountSharePermission @default(read_only)
  updatedAt         DateTime               @updatedAt
  userId            String                 @db.Uuid

  account Account @relation(fields: [accountId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([accountId, userId], map: "index_account_shares_on_account_id_and_user_id")
  @@index([accountId], map: "index_account_shares_on_account_id")
  @@index([userId, includeInFinances], map: "index_account_shares_on_user_id_and_include_in_finances")
  @@index([userId], map: "index_account_shares_on_user_id")
  @@map("account_shares")
}

model AccountStatement {
  id                    String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String?                        @db.Uuid
  accountLast4Hint      String?                        @db.VarChar(4)
  accountNameHint       String?                        @db.VarChar(200)
  byteSize              BigInt
  checksum              String                         @db.VarChar(64)
  closingBalance        Decimal?                       @db.Decimal(19, 4)
  contentSha256         String?
  contentType           String                         @db.VarChar(100)
  createdAt             DateTime                       @default(now())
  currency              String?                        @db.VarChar(3)
  familyId              String                         @db.Uuid
  filename              String                         @db.VarChar(255)
  institutionNameHint   String?                        @db.VarChar(200)
  matchConfidence       Decimal?                       @db.Decimal(5, 4)
  openingBalance        Decimal?                       @db.Decimal(19, 4)
  parserConfidence      Decimal?                       @db.Decimal(5, 4)
  periodEndOn           DateTime?
  periodStartOn         DateTime?
  reviewStatus          AccountStatementReviewStatus   @default(unmatched)
  sanitizedParserOutput Json                           @default("{}")
  source                String                         @default("manual_upload") @db.VarChar(255)
  suggestedAccountId    String?                        @db.Uuid
  updatedAt             DateTime                       @updatedAt
  uploadStatus          AccountStatementUploadStatus   @default(stored)

  account           Account?               @relation(fields: [accountId], references: [id])
  family            Family                 @relation(fields: [familyId], references: [id])
  suggestedAccount  Account?               @relation("AccountStatementSuggestedAccount", fields: [suggestedAccountId], references: [id])
  reconciledEntries Entry[]
  imports           Import[]

  @@index([accountId, periodStartOn, periodEndOn], map: "index_account_statements_on_account_period")
  @@index([accountId], map: "index_account_statements_on_account_id")
  @@index([familyId, checksum], map: "index_account_statements_on_family_checksum")
  @@unique([familyId, contentSha256], map: "index_account_statements_on_family_content_sha256")
  @@index([familyId, reviewStatus], map: "index_account_statements_on_family_review_status")
  @@index([familyId], map: "index_account_statements_on_family_id")
  @@index([suggestedAccountId, reviewStatus], map: "index_account_statements_on_suggested_account_review")
  @@index([suggestedAccountId], map: "index_account_statements_on_suggested_account_id")
  @@map("account_statements")
}

model Account {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountableId          String?  @db.Uuid
  accountableType        String?
  accountProvidersCount  Int      @default(0)
  balance                Decimal? @db.Decimal(19, 4)
  cashBalance            Decimal  @default("0") @db.Decimal(19, 4)
  classification         String?
  createdAt              DateTime @default(now())
  currency               String?
  disabledAt             DateTime?
  enableCategoryMatcher  Boolean  @default(true)
  excludeFromReports     Boolean  @default(false)
  familyId               String   @db.Uuid
  importId               String?  @db.Uuid
  institutionDomain      String?
  institutionName        String?
  lockedAttributes       Json?    @default("{}")
  name                   String?
  notes                  String?  @db.Text
  ownerId                String?  @db.Uuid
  plaidAccountId         String?  @db.Uuid
  simplefinAccountId     String?  @db.Uuid
  status                 String   @default("active")
  subtype                String?
  updatedAt              DateTime @updatedAt

  family              Family               @relation(fields: [familyId], references: [id])
  owner               User?                @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  import              Import?              @relation("AccountImport", fields: [importId], references: [id], onDelete: SetNull)
  accountShares       AccountShare[]
  accountProviders    AccountProvider[]
  accountStatements   AccountStatement[]
  suggestedStatements AccountStatement[]   @relation("AccountStatementSuggestedAccount")
  balances            Balance[]
  holdings            Holding[]
  entries             Entry[]
  goalAccounts        GoalAccount[]
  goalPledges         GoalPledge[]
  recurringTransactions RecurringTransaction[] @relation("RecurringTransactionAccount")
  destinationRecurringTransactions RecurringTransaction[] @relation("RecurringTransactionDestinationAccount")
  defaultAccountForUsers User[]              @relation("UserDefaultAccount")
  importAccounts        Import[]             @relation("ImportAccount")

  @@index([accountableId, accountableType], map: "index_accounts_on_accountable_id_and_accountable_type")
  @@index([accountableType], map: "index_accounts_on_accountable_type")
  @@index([currency], map: "index_accounts_on_currency")
  @@index([familyId, accountableType], map: "index_accounts_on_family_id_and_accountable_type")
  @@index([familyId, excludeFromReports], map: "index_accounts_on_family_id_and_exclude_from_reports")
  @@index([familyId, id], map: "index_accounts_on_family_id_and_id")
  @@index([familyId, status, accountableType], map: "index_accounts_on_family_id_status_accountable_type")
  @@index([familyId, status], map: "index_accounts_on_family_id_and_status")
  @@index([familyId], map: "index_accounts_on_family_id")
  @@index([importId], map: "index_accounts_on_import_id")
  @@index([ownerId], map: "index_accounts_on_owner_id")
  @@index([plaidAccountId], map: "index_accounts_on_plaid_account_id")
  @@index([simplefinAccountId], map: "index_accounts_on_simplefin_account_id")
  @@index([status], map: "index_accounts_on_status")
  @@map("accounts")
}

model Address {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
