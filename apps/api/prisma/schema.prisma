  rawPayload        Json?
  scaPrivateKey     String?  @db.Text
  scheduledForDeletion Boolean @default(false)
  status            String   @default("good")
  syncStartDate     DateTime?
  token             String?  @db.Text
  updatedAt         DateTime @updatedAt

  @@unique([familyId, profileId], map: "index_wise_items_on_family_id_and_profile_id")
  @@index([familyId], map: "index_wise_items_on_family_id")
  @@index([status], map: "index_wise_items_on_status")
  @@map("wise_items")
}

model WiseAccount {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  balanceId             String
  currency              String
  currentBalance        Decimal? @db.Decimal(19, 4)
  name                  String?
  rawPayload            Json?
  rawTransactionsPayload Json?
  reservedBalance       Decimal? @db.Decimal(19, 4)
  updatedAt             DateTime @updatedAt
  wiseItemId            String   @db.Uuid

  @@unique([wiseItemId, balanceId], map: "index_wise_accounts_on_wise_item_id_and_balance_id")
  @@index([wiseItemId], map: "index_wise_accounts_on_wise_item_id")
  @@map("wise_accounts")
}